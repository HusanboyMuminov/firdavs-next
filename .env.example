# Copy to .env.local (development) or set in your host's environment (production).
# Never commit real values.

# Public URL of the site — used for link previews (not needed on Vercel).
SITE_URL=https://menu.example.com

# Admin dashboard (/admin). Use a long, unique password (min. 8 characters).
ADMIN_PASSWORD=

# SQLite database file for analytics, admin sessions and push subscriptions.
# Must be on a persistent disk.
DATABASE_PATH=.data/firdavs.sqlite

# Web Push. Generate a key pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: address or your https:// site URL.
VAPID_SUBJECT=mailto:you@example.com

# Kitchen SMS for table orders — set ONE provider. Until then, orders are saved and
# shown in the admin dashboard, and guests are asked to send the SMS themselves.
# SMS_FROM must be a sender number registered with the provider (required in Korea).
# Solapi (Korea, https://solapi.com):
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# Twilio (alternative):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
# Kitchen phone that receives orders (default: 010-3238-2555).
ORDER_SMS_TO=
# Optional: number of tables (Confirm rejects higher table numbers). Empty = 1–999.
TABLE_COUNT=
